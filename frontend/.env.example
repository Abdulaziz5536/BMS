# For local development, the Vite app talks to the backend on port 3000.
VITE_API_BASE=http://localhost:3000
VITE_ALLOW_SIGNUP=true

# For separate production frontend hosting, use your backend domain:
# VITE_API_BASE=https://api.your-domain.com
#
# If the backend serves frontend/dist from the same domain, this can be left unset.

# Set false after the owner/admin account exists.
# VITE_ALLOW_SIGNUP=false
