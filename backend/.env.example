NODE_ENV=development
PORT=3000
APP_NAME=Building Management System
MONGO_URI=mongodb://127.0.0.1:27017/bms

# Required for login tokens. Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated frontend URLs allowed to call this backend.
# In production with separate frontend hosting, set this to your frontend domain.
CORS_ORIGINS=http://localhost:5173

# Keep true/blank when the backend should serve frontend/dist after npm run build.
# Set false only if the frontend is deployed separately.
SERVE_FRONTEND=true

# Set false after the first owner/admin account is created on a public deployment.
ALLOW_SIGNUP=true

DUE_REMINDER_ENABLED=false
DUE_REMINDER_DAYS_AHEAD=3
DUE_REMINDER_INTERVAL_MINUTES=1440
DUE_REMINDER_SEND_EMAIL=false
DUE_REMINDER_SEND_SMS=false

UTILITY_REMINDER_ENABLED=false
UTILITY_REMINDER_DAYS_AHEAD=3
UTILITY_REMINDER_INTERVAL_MINUTES=1440
UTILITY_REMINDER_SEND_EMAIL=false
UTILITY_REMINDER_SEND_SMS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional per-building SMTP. Use a normalized building name or first word.
# Example: "Aymen Commercial Center" can use SMTP_AYMEN_USER / SMTP_AYMEN_PASS.
SMTP_AYMEN_USER=
SMTP_AYMEN_PASS=
SMTP_AYMEN_FROM=

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Optional per-building SMS sender IDs using the same SMS API key.
# Example: "Aymen Commercial Center" can use SMS_AYMEN_SENDER_ID.
SMS_AYMEN_SENDER_ID=
